{
  "runtime.version": "Lua 5.4",
  "runtime.path": ["modules/?.lua", "modules/?/init.lua"],
  "runtime.builtin": { "io": "disable", "os": "disable", "debug": "disable" },
  "workspace.library": [".netherforge/luals"],
