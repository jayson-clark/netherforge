{
  "$schema": "../../.netherforge/schema/centity.schema.json",
  "name": "Kiosk",
  "nodes": {
    "button": {
      "parent": "root",
      "transform": {
        "translation": [-0.2, 1, -0.2],
        "scale": [0.4, 0.12, 0.4]
      },
      "display": {
        "type": "block",
        "block": "minecraft:gold_block"
      },
      "hitbox": {
        "boxes": [
          {
            "min": [0, 0, 0],
            "max": [1, 2, 1]
          }
        ]
      }
    },
    "label": {
      "parent": "root",
      "transform": {
        "translation": [0, 1.55, 0]
      },
      "display": {
        "type": "text",
        "text": "<yellow>Click me",
        "billboard": "center"
      }
    },
    "pedestal": {
      "parent": "root",
      "transform": {
        "translation": [-0.35, 0, -0.35],
        "scale": [0.7, 1, 0.7]
      },
      "display": {
        "type": "block",
        "block": "minecraft:polished_blackstone_bricks"
      },
      "hitbox": {}
    },
    "root": {}
  },
  "animations": {
    "press": {
      "loop": "once",
      "tracks": {
        "button": {
          "translation": [
            {
              "time": 0,
              "value": [-0.2, 1, -0.2]
            },
            {
              "time": 0.1,
              "value": [-0.2, 0.95, -0.2],
              "easing": "ease_out"
            },
            {
              "time": 0.3,
              "value": [-0.2, 1, -0.2]
            }
          ]
        }
      }
    }
  }
}
