{
  "$schema": "../../.netherforge/schema/centity.schema.json",
  "name": "Item on show",
  "nodes": {
    "item": {
      "transform": {
        "translation": [0, 0.5, 0],
        "scale": [0.6, 0.6, 0.6]
      },
      "display": {
        "type": "item",
        "item": "minecraft:paper",
        "itemTransform": "fixed"
      }
    }
  },
  "animations": {
    "turn": {
      "loop": "loop",
      "autoplay": true,
      "tracks": {
        "item": {
          "rotation": [
            {
              "time": 0,
              "value": [0, 0, 0]
            },
            {
              "time": 6,
              "value": [0, 360, 0]
            }
          ]
        }
      }
    }
  }
}
