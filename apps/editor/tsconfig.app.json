{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vite/client"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  },
  "include": ["src"],
  "//exclude": "Tests that drive real processes run in Node, type-checked with tsconfig.node.json (or, for the Tauri side, tsconfig.tauri.json).",
  "exclude": ["src/**/*.node.test.ts", "src/**/*.tauri.test.ts"]
}
